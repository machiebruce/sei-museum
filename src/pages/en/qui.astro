---
import "../../style/global.css";
import Buttons from "../../components/Buttons.astro";
---

<!doctype html>
<html lang='en' class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <title>SEI Museum</title>
  </head>
  <body class='bg-black antialiased'>
    <main class='flex flex-col gap-8 bg-black h-screen justify-center items-center'>
      <img class='h-64 w-64' src='../sei_logo.svg' alt='museum logo' />
      <Buttons label='click to start' link='/en' />
    </main>
  </body>
</html>
