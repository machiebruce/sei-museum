---
import "../style/global.css";
import LangSwitch from "../components/LangSwitch.astro";

interface Props {
  title: string;
}

const {title} = Astro.props;
---

<!doctype html>
<html lang='en' class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />
    <meta name='description' content='Astro description' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class='bg-neutral-900 antialiased'>
    <LangSwitch />
    <slot />
  </body>
</html>

<script>
  import { animateLangSwitch, animateNav } from "../scripts/animations.js";

  document.addEventListener("astro:page-load", () => {
    animateLangSwitch();
    animateNav();
  });
</script>

<script>
  // Le transizioni SPA di Astro (ClientRouter) sono state rimosse: iniettavano il
  // nuovo DOM (immagini incluse) prima di aggiornare l'URL della pagina, quindi i
  // percorsi relativi degli asset venivano risolti alla profondita' sbagliata e
  // le immagini restavano rotte finche' non si faceva un refresh manuale. Ogni
  // link e' di nuovo una navigazione normale del browser; qui riemettiamo
  // "astro:page-load" cosi' gli script di animazione delle singole pagine
  // continuano a funzionare senza modifiche.
  window.addEventListener("load", () => {
    document.dispatchEvent(new Event("astro:page-load"));
  });
</script>

<script src='../scripts/reset-page.js'></script>
